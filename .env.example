APP_ENV=local
LOG_LEVEL=info
IMAGE_SHA=dev

DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/pharm
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=replace-with-32-byte-base64-local-secret
REFRESH_SECRET=replace-with-32-byte-base64-local-secret
SENTRY_DSN=

LLM_PROVIDER=fake
LLM_MODEL_PATH=models/llama-3.1-8b-instruct.Q4_K_M.gguf
LLM_CONTEXT_SIZE=4096
LLM_N_THREADS=4
LLM_MAX_OUTPUT_TOKENS=512

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MONTHLY_USD_CAP=50.00

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_DIR=var/faiss
RAG_CHUNK_TOKENS=512
RAG_CHUNK_OVERLAP=64
RAG_MAX_CONTEXT_TOKENS=3000
CITATION_MIN_OVERLAP_RATIO=0.4
GENERATION_RETRY_BUDGET=3
RATE_LIMIT_DEFAULT=30/minute

UPLOAD_MAX_BYTES=52428800

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=pharm-sources-local
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

CORS_ALLOWED_ORIGINS=http://localhost:3000
WEB_PUBLIC_API_URL=http://localhost:8000
